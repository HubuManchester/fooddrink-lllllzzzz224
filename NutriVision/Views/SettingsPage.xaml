<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:NutriVision.ViewModels"
             x:Class="NutriVision.Views.SettingsPage"
             x:DataType="viewModels:SettingsViewModel"
             Title="Settings">
    <ContentPage.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{DynamicResource AppSecondaryTextColor}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextTransform" Value="Uppercase" />
        </Style>
        <Style x:Key="ChipLabelStyle" TargetType="Label">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="BackgroundColor" Value="{DynamicResource AppChipBackgroundColor}" />
            <Setter Property="TextColor" Value="{DynamicResource AppChipTextColor}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='18,16', Tablet='28,20', Desktop='32,20'}"
                             Spacing="16">
            <Label Text="App Preferences"
                   FontSize="{DynamicResource AppSubHeadlineFontSize}"
                   FontAttributes="Bold" />
            <Label Text="Tune appearance and accessibility behavior."
                   TextColor="{DynamicResource AppSecondaryTextColor}" />

            <Border Padding="0">
                <Grid HeightRequest="126">
                    <Image Aspect="AspectFill" Source="card_healthysnack.png" />
                    <Grid BackgroundColor="#3A000000"/>
                    <VerticalStackLayout Padding="14" VerticalOptions="End">
                        <Label Text="Personalize your tracking"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="20" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <FlexLayout Wrap="Wrap">
                <Label Text="THEME" Style="{StaticResource ChipLabelStyle}" />
                <Label Text="TYPOGRAPHY" Style="{StaticResource ChipLabelStyle}" />
                <Label Text="ACCESSIBILITY" Style="{StaticResource ChipLabelStyle}" />
            </FlexLayout>

            <Border Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Display" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="Theme" />
                    <Picker SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}"
                            SemanticProperties.Description="Select app theme">
                        <Picker.Items>
                            <x:String>System</x:String>
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                        </Picker.Items>
                    </Picker>

                    <Label Text="Font size" />
                    <Picker SelectedIndex="{Binding SelectedFontScaleIndex, Mode=TwoWay}"
                            SemanticProperties.Description="Select font size">
                        <Picker.Items>
                            <x:String>Small</x:String>
                            <x:String>Medium</x:String>
                            <x:String>Large</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Border>

            <Border Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Accessibility" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Speech enabled" VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding TtsEnabled, Mode=TwoWay}"
                                SemanticProperties.Description="Enable or disable speech output" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="High contrast mode" VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding HighContrastEnabled, Mode=TwoWay}"
                                SemanticProperties.Description="Enable or disable high contrast mode" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Apply Settings"
                    SemanticProperties.Description="Apply settings and save them"
                    Command="{Binding ApplyCommand}" />

            <Border Padding="14">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Status" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="{Binding ApplyMessage}" TextColor="{DynamicResource AppSuccessTextColor}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
