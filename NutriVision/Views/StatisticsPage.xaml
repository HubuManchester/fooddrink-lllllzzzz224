<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:NutriVision.ViewModels"
             xmlns:models="clr-namespace:NutriVision.Models"
             x:Class="NutriVision.Views.StatisticsPage"
             x:DataType="viewModels:StatisticsViewModel"
             Title="Statistics">
    <ContentPage.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{DynamicResource AppSecondaryTextColor}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextTransform" Value="Uppercase" />
        </Style>
        <Style x:Key="ChipLabelStyle" TargetType="Label">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="BackgroundColor" Value="{DynamicResource AppChipBackgroundColor}" />
            <Setter Property="TextColor" Value="{DynamicResource AppChipTextColor}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='18,16', Tablet='28,20', Desktop='32,20'}"
                             Spacing="16">
            <Label Text="Nutrition Analytics"
                   FontSize="{DynamicResource AppSubHeadlineFontSize}"
                   FontAttributes="Bold" />
            <Label Text="7-day trend and macro distribution."
                   TextColor="{DynamicResource AppSecondaryTextColor}" />

            <Border Padding="0">
                <Grid HeightRequest="126">
                    <Image Aspect="AspectFill" Source="card_hydration.png" />
                    <Grid BackgroundColor="#40000000"/>
                    <VerticalStackLayout Padding="14" VerticalOptions="End">
                        <Label Text="Weekly nutrition insights"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="20" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <FlexLayout Wrap="Wrap">
                <Label Text="TREND" Style="{StaticResource ChipLabelStyle}" />
                <Label Text="MACRO RATIO" Style="{StaticResource ChipLabelStyle}" />
                <Label Text="LIVE SUMMARY" Style="{StaticResource ChipLabelStyle}" />
            </FlexLayout>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding DateRangeText}"
                           TextColor="{DynamicResource AppSecondaryTextColor}" />
                    <Label Text="{Binding TotalCaloriesText}"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Refresh"
                        Command="{Binding LoadCommand}"
                        SemanticProperties.Description="Refresh statistics data" />
            </Grid>

            <Border Padding="14">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Status" Style="{StaticResource SectionTitleStyle}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource AppErrorTextColor}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="7-Day Calories Trend" Style="{StaticResource SectionTitleStyle}" />
                    <CollectionView ItemsSource="{Binding DailyTrend}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No data yet."
                                   TextColor="{DynamicResource AppSecondaryTextColor}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:DailyCaloriesBarItem">
                                <Grid ColumnDefinitions="52,*,74" ColumnSpacing="8" Padding="0,2">
                                    <Label Text="{Binding DayLabel}" />
                                    <ProgressBar Grid.Column="1"
                                                 Progress="{Binding Progress}" />
                                    <Label Grid.Column="2"
                                           HorizontalTextAlignment="End"
                                           Text="{Binding CaloriesLabel}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Macro Ratio" Style="{StaticResource SectionTitleStyle}" />

                    <Label Text="{Binding ProteinPercent, StringFormat='Protein {0:F1}%'}" />
                    <ProgressBar Progress="{Binding ProteinProgress}" />

                    <Label Text="{Binding FatPercent, StringFormat='Fat {0:F1}%'}" />
                    <ProgressBar Progress="{Binding FatProgress}" />

                    <Label Text="{Binding CarbsPercent, StringFormat='Carbs {0:F1}%'}" />
                    <ProgressBar Progress="{Binding CarbsProgress}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
