<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriVision.Views.ScanPage"
             Title="Scan">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Food Recognition" FontSize="{DynamicResource AppSubHeadlineFontSize}" FontAttributes="Bold" />
            <Button Text="Capture And Recognize"
                    SemanticProperties.Description="Capture food image and run recognition"
                    Command="{Binding ScanCommand}" />
            <Button Text="Voice Input Food Name"
                    SemanticProperties.Description="Use microphone to speak food name"
                    Command="{Binding VoiceInputCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusText}" />
            <Label Text="{Binding RecognizedFood}" FontAttributes="Bold" />
            <Label Text="{Binding NutritionText}" />
            <Label Text="{Binding Location}" />
            <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource AppErrorTextColor}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
