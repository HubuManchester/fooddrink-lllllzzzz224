<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:NutriVision.ViewModels"
             x:Class="NutriVision.Views.ScanPage"
             x:DataType="viewModels:ScanViewModel"
             Title="Scan">
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12', Tablet='28,20', Desktop='32,20'}"
                             Spacing="12">
            <Label Text="Food Recognition"
                   FontSize="{DynamicResource AppSubHeadlineFontSize}"
                   FontAttributes="Bold" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Capture And Recognize"
                        SemanticProperties.Description="Capture food image and run recognition"
                        Command="{Binding ScanCommand}" />
                <Button Grid.Column="1"
                        Text="Voice Input Food Name"
                        SemanticProperties.Description="Use microphone to speak food name"
                        Command="{Binding VoiceInputCommand}" />
            </Grid>

            <Border Padding="12" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="8">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <Label Text="{Binding StatusText}" />
                    <Label Text="{Binding RecognizedFood}" FontAttributes="Bold" />
                    <Label Text="{Binding NutritionText}" LineBreakMode="WordWrap" />
                    <Label Text="{Binding Location}" LineBreakMode="WordWrap" />
                    <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource AppErrorTextColor}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
