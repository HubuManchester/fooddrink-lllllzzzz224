<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:NutriVision.ViewModels"
             x:Class="NutriVision.Views.HomePage"
             x:DataType="viewModels:HomeViewModel"
             Title="Home">
    <ContentPage.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{DynamicResource AppSecondaryTextColor}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextTransform" Value="Uppercase" />
        </Style>
        <Style x:Key="ChipLabelStyle" TargetType="Label">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="BackgroundColor" Value="{DynamicResource AppChipBackgroundColor}" />
            <Setter Property="TextColor" Value="{DynamicResource AppChipTextColor}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </ContentPage.Resources>
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="{OnIdiom Phone='18,16', Tablet='28,20', Desktop='32,20'}"
                                 Spacing="16">
            <SearchBar Placeholder="Search foods or meals"
                       SemanticProperties.Description="Search foods" />

            <HorizontalStackLayout Spacing="8">
                <Button Text="Favorites" Padding="12,8" />
                <Button Text="History" Padding="12,8" Command="{Binding LoadCommand}" />
                <Button Text="Nearby" Padding="12,8" Command="{Binding RefreshLocationCommand}" />
            </HorizontalStackLayout>

            <Border Padding="0">
                <Grid HeightRequest="160">
                    <Image Aspect="AspectFill"
                           Source="banner_food.png" />
                    <Grid BackgroundColor="#55000000"/>
                    <VerticalStackLayout Padding="16" VerticalOptions="Center">
                        <Label Text="NutriVision"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label Text="Today's calories"
                               TextColor="#E5FFFFFF" />
                        <Label Text="{Binding TodayCalories}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="Quick Categories"
                       FontSize="{DynamicResource AppSubHeadlineFontSize}"
                       FontAttributes="Bold" />
                <Label Grid.Column="1"
                       Text=">"
                       HorizontalOptions="End"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource AppSecondaryTextColor}" />
            </Grid>

            <ScrollView Orientation="Horizontal">
                <HorizontalStackLayout Spacing="14">
                    <VerticalStackLayout WidthRequest="86" Spacing="6">
                        <Border WidthRequest="76" HeightRequest="76" StrokeShape="RoundRectangle 38" Padding="0">
                            <Image Aspect="AspectFill" Source="cat_water.png" />
                        </Border>
                        <Label Text="Water" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout WidthRequest="86" Spacing="6">
                        <Border WidthRequest="76" HeightRequest="76" StrokeShape="RoundRectangle 38" Padding="0">
                            <Image Aspect="AspectFill" Source="cat_protein.png" />
                        </Border>
                        <Label Text="Protein" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout WidthRequest="86" Spacing="6">
                        <Border WidthRequest="76" HeightRequest="76" StrokeShape="RoundRectangle 38" Padding="0">
                            <Image Aspect="AspectFill" Source="cat_vegetable.png" />
                        </Border>
                        <Label Text="Vegetable" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout WidthRequest="86" Spacing="6">
                        <Border WidthRequest="76" HeightRequest="76" StrokeShape="RoundRectangle 38" Padding="0">
                            <Image Aspect="AspectFill" Source="cat_snack.png" />
                        </Border>
                        <Label Text="Snack" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </ScrollView>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="Recommendations"
                       FontSize="{DynamicResource AppSubHeadlineFontSize}"
                       FontAttributes="Bold" />
                <Label Grid.Column="1"
                       Text=">"
                       HorizontalOptions="End"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource AppSecondaryTextColor}" />
            </Grid>

            <ScrollView Orientation="Horizontal">
                <HorizontalStackLayout Spacing="10">
                    <Border Padding="0" WidthRequest="170">
                        <VerticalStackLayout Spacing="8">
                            <Image HeightRequest="110" Aspect="AspectFill" Source="card_lowcal.png" />
                            <VerticalStackLayout Padding="10,0,10,10" Spacing="2">
                                <Label Text="Brand" TextColor="{DynamicResource AppSecondaryTextColor}" FontSize="12" />
                                <Label Text="Low-cal meal" FontAttributes="Bold" />
                                <Label Text="{Binding LatestSummary}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Padding="0" WidthRequest="170">
                        <VerticalStackLayout Spacing="8">
                            <Image HeightRequest="110" Aspect="AspectFill" Source="card_highprotein.png" />
                            <VerticalStackLayout Padding="10,0,10,10" Spacing="2">
                                <Label Text="Brand" TextColor="{DynamicResource AppSecondaryTextColor}" FontSize="12" />
                                <Label Text="High-protein meal" FontAttributes="Bold" />
                                <Label Text="{Binding LocationText}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Padding="0" WidthRequest="170">
                        <VerticalStackLayout Spacing="8">
                            <Image HeightRequest="110" Aspect="AspectFill" Source="card_hydration.png" />
                            <VerticalStackLayout Padding="10,0,10,10" Spacing="2">
                                <Label Text="Brand" TextColor="{DynamicResource AppSecondaryTextColor}" FontSize="12" />
                                <Label Text="Hydration drink" FontAttributes="Bold" />
                                <Label Text="Volume-aware serving" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Padding="0" WidthRequest="170">
                        <VerticalStackLayout Spacing="8">
                            <Image HeightRequest="110" Aspect="AspectFill" Source="card_healthysnack.png" />
                            <VerticalStackLayout Padding="10,0,10,10" Spacing="2">
                                <Label Text="Brand" TextColor="{DynamicResource AppSecondaryTextColor}" FontSize="12" />
                                <Label Text="Healthy snack" FontAttributes="Bold" />
                                <Label Text="Portion tracking" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Speak Summary"
                        SemanticProperties.Description="Speak home summary with text to speech"
                        Command="{Binding SpeakSummaryCommand}" />
                <Button Grid.Column="1"
                        Text="Get Location"
                        SemanticProperties.Description="Get current location"
                        Command="{Binding RefreshLocationCommand}" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsSpeaking}"
                               IsVisible="{Binding IsSpeaking}" />
            <Label Text="{Binding SpeechMessage}" TextColor="{DynamicResource AppSuccessTextColor}" />
                <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource AppErrorTextColor}" />
            </VerticalStackLayout>
        </ScrollView>

        <Border
            IsVisible="{Binding IsLocationPopupVisible}"
            Padding="14,12"
            Margin="{OnIdiom Phone='14,14,14,0', Tablet='30,18,30,0', Desktop='36,18,36,0'}"
            VerticalOptions="Start"
            HorizontalOptions="Fill"
            BackgroundColor="{DynamicResource AppCardBackgroundColor}"
            Stroke="{DynamicResource AppAccentColor}"
            StrokeThickness="1.5"
            Shadow="{StaticResource AppCardShadow}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding DismissLocationPopupCommand}" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Label Text="Location"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource AppAccentColor}" />
                <Label Text="{Binding LocationPopupMessage}"
                       LineBreakMode="TailTruncation"
                       HorizontalOptions="FillAndExpand" />
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>
