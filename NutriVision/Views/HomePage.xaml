<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:NutriVision.ViewModels"
             x:Class="NutriVision.Views.HomePage"
             x:DataType="viewModels:HomeViewModel"
             Title="Home">
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12', Tablet='28,20', Desktop='32,20'}"
                             Spacing="12">
            <Label Text="NutriVision"
                   FontSize="{DynamicResource AppHeadlineFontSize}"
                   FontAttributes="Bold" />

            <Border Padding="12" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Today's calories" FontAttributes="Bold" />
                    <Label Text="{Binding TodayCalories}"
                           FontSize="{DynamicResource AppSubHeadlineFontSize}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="12" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Latest 3 records" FontAttributes="Bold" />
                    <Label Text="{Binding LatestSummary}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Refresh"
                        SemanticProperties.Description="Refresh home data"
                        Command="{Binding LoadCommand}" />
                <Button Grid.Column="1"
                        Text="Speak Summary"
                        SemanticProperties.Description="Speak home summary with text to speech"
                        Command="{Binding SpeakSummaryCommand}" />
            </Grid>

            <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource AppErrorTextColor}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
